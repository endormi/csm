<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <PackageId>csmcs</PackageId>
    <Version>0.1.0</Version>
    <Authors>Endormi</Authors>
    <Description>Color scheme manager package for your projects</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <RepositoryUrl>https://github.com/endormi/csm</RepositoryUrl>
    <PackageProjectUrl>https://github.com/endormi/csm</PackageProjectUrl>

    <PackageTags>color scheme ansi yaml terminal</PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
